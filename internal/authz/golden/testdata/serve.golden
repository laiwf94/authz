< Cache-Control: no-store
< Content-Type: application/json
< X-Content-Type-Options: nosniff
< X-Request-Id: golden-05
{"cursor":"","read_at":"AQAAAAAAAAAFs1ReST4Fc9SW3jc8dVWfeQ","relationships":["doc:design#editor@group:eng#member","doc:design#parent@folder:specs","doc:notes#owner@user:bob","doc:notes#parent@folder:pub"]}
